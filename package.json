{
  "name": "inspector-goadget",
  "version": "2.2.0",
  "description": "A Cypress library for automating UI tests on Alberta Design System (goa-*) web components.",
  "keywords": [
    "cypress",
    "alberta design system",
    "goa",
    "web components",
    "shadow dom",
    "testing"
  ],
  "homepage": "https://github.com/yaroslav-rybiak/inspector-goadget#readme",
  "bugs": {
    "url": "https://github.com/yaroslav-rybiak/inspector-goadget/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yaroslav-rybiak/inspector-goadget.git"
  },
  "license": "Apache-2.0",
  "author": "Yaroslav Rybiak",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "node scripts/cypress.mjs run --browser chrome",
    "test:open": "node scripts/cypress.mjs open --e2e --browser chrome",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "cypress": ">=13"
  },
  "devDependencies": {
    "@abgov/web-components": "3.2.0",
    "cypress": "^16.2.1",
    "ionicons": "8.1.0",
    "typescript": "^7.0.2"
  }
}
